        }
      ],
      "title": "Risk Class Distribution",
      "type": "barchart"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
